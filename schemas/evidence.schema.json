{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "category",
    "subject",
    "producer",
    "check",
    "status",
    "details",
    "artifacts",
    "createdAt",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "structure",
        "security",
        "compatibility",
        "execution",
        "enforcement",
        "human-review"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "producer": {
      "type": "object"
    },
    "check": {
      "$ref": "#/$defs/check"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "error",
        "not-run",
        "inconclusive",
        "blocked",
        "unsupported"
      ]
    },
    "details": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "subject": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256",
        "sourceRevision",
        "lockDigest",
        "adapterDigest",
        "components"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "lockDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapterDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "ciProducer": {
      "type": "object",
      "required": [
        "type",
        "identity",
        "workflowRevision",
        "runUrl"
      ],
      "properties": {
        "type": {
          "const": "ci"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "workflowRevision": {
          "type": "string",
          "minLength": 1
        },
        "runUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "humanProducer": {
      "type": "object",
      "required": [
        "type",
        "identity",
        "reviewUrl"
      ],
      "properties": {
        "type": {
          "const": "human"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "reviewUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "name",
        "suiteDigest",
        "fixtureDigest",
        "configDigest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "suiteDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixtureDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "redactionReview"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "redactionReview": {
          "enum": [
            "passed",
            "not-required"
          ]
        }
      },
      "additionalProperties": false
    },
    "structure": {
      "type": "object",
      "required": [
        "validator",
        "validatorVersion",
        "rulesDigest",
        "findings"
      ],
      "properties": {
        "validator": {
          "type": "string",
          "minLength": 1
        },
        "validatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "rulesDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ruleId",
              "severity",
              "location",
              "message"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "scanner",
        "scannerVersion",
        "rulesDigest",
        "outcome",
        "findings",
        "suppressions",
        "coverageLimitations"
      ],
      "properties": {
        "scanner": {
          "type": "string",
          "minLength": 1
        },
        "scannerVersion": {
          "type": "string",
          "minLength": 1
        },
        "rulesDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outcome": {
          "enum": [
            "no_findings",
            "findings_present",
            "scan_error",
            "not_run"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ruleId",
              "severity",
              "location",
              "message"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 0
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ruleId",
              "reason",
              "reviewRef",
              "expiresAt"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "reviewRef": {
                "type": "string",
                "format": "uri"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "minItems": 0
        },
        "coverageLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "host",
        "hostVersion",
        "os",
        "toolchain",
        "testCases"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "hostVersion": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "testCases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "not-run",
                  "unsupported"
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "object",
      "required": [
        "runtime",
        "runtimeVersion",
        "policyDigest",
        "controls"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control",
              "coverage",
              "reason"
            ],
            "properties": {
              "control": {
                "enum": [
                  "filesystem-scope",
                  "network-scope",
                  "human-approval-gates"
                ]
              },
              "coverage": {
                "enum": [
                  "enforced",
                  "partial",
                  "not-enforced",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 3,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "control": {
                    "const": "filesystem-scope"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "control": {
                    "const": "network-scope"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "control": {
                    "const": "human-approval-gates"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "host",
        "hostVersion",
        "os",
        "toolchain",
        "model",
        "modelConfigDigest",
        "harnessDigest",
        "scorerDigest",
        "policyDigest",
        "attempts"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "hostVersion": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelConfigDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "harnessDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scorerDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "assertionsExecuted",
              "assertionsPassed",
              "assertionsFailed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "timeout",
                  "skipped",
                  "blocked",
                  "not-run"
                ]
              },
              "assertionsExecuted": {
                "type": "integer",
                "minimum": 0
              },
              "assertionsPassed": {
                "type": "integer",
                "minimum": 0
              },
              "assertionsFailed": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "decision",
        "reviewType",
        "candidateDigest",
        "scopeDigest",
        "actions",
        "rationale"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject",
            "request-changes"
          ]
        },
        "reviewType": {
          "enum": [
            "content-review",
            "action-approval"
          ]
        },
        "candidateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scopeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "structure"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/structure"
          },
          "producer": {
            "$ref": "#/$defs/ciProducer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "security"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/security"
          },
          "producer": {
            "$ref": "#/$defs/ciProducer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "compatibility"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/compatibility"
          },
          "producer": {
            "$ref": "#/$defs/ciProducer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "execution"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/execution"
          },
          "producer": {
            "$ref": "#/$defs/ciProducer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "enforcement"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/enforcement"
          },
          "producer": {
            "$ref": "#/$defs/ciProducer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "human-review"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/review"
          },
          "producer": {
            "$ref": "#/$defs/humanProducer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "security"
          },
          "details": {
            "properties": {
              "outcome": {
                "const": "no_findings"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "security"
          },
          "details": {
            "properties": {
              "outcome": {
                "const": "findings_present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "security"
          },
          "details": {
            "properties": {
              "outcome": {
                "const": "scan_error"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "security"
          },
          "details": {
            "properties": {
              "outcome": {
                "const": "not_run"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "not-run"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "execution"
          },
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "properties": {
              "attempts": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "const": "pass"
                    },
                    "assertionsExecuted": {
                      "minimum": 1
                    },
                    "assertionsFailed": {
                      "const": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "enforcement"
          },
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "properties": {
              "controls": {
                "items": {
                  "properties": {
                    "coverage": {
                      "const": "enforced"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "human-review"
          },
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "properties": {
              "decision": {
                "const": "approve"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "security"
          },
          "details": {
            "properties": {
              "outcome": {
                "const": "no_findings"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "security"
          },
          "details": {
            "properties": {
              "outcome": {
                "const": "findings_present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "fail"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "compatibility"
          },
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "properties": {
              "testCases": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "pass"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "structure"
          },
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
